# Copy to .env and fill in.
PORT=4000
NODE_ENV=development
# Dates (case numbers, report filters) use this time zone
TZ=Asia/Kolkata

# Local MongoDB or an Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/reliable
# If an Atlas (mongodb+srv://) link fails with "querySrv ECONNREFUSED", uncomment:
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Long random string — e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
# Executive app stays signed in longer
JWT_EXEC_EXPIRES_IN=7d

# Panel URL(s) allowed to call the API (comma-separated)
CORS_ORIGIN=http://localhost:5173

# Where uploaded photos / documents are written
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
# Closed cases (database record + photos + documents) are permanently deleted this many
# days after closing. Checked every 6 hours. 0 = never delete.
CASE_RETENTION_DAYS=90

# First admin account created by `npm run seed`
ADMIN_NAME=Anjum Admin
ADMIN_EMAIL=admin@reliable.in
ADMIN_PASSWORD=ChangeMe@123

# Shows the "Demo: start / submit visit" endpoint (never enable in production)
ENABLE_DEMO_TOOLS=true

# Agency manager's contact number, printed on the field executives' digital ID card
AGENCY_MANAGER_PHONE=

# Google Maps Static API key — satellite map on the field app's GPS photos (blank = free OpenStreetMap)
GOOGLE_MAPS_KEY=
